# Copy this file to .env and fill it in. Never share or commit .env.

# true  = built-in demo data, no lab needed
# false = read from the real FortiGate below
SIM_MODE=true

# FortiGate management IP or hostname (add :port if not 443)
FGT_HOST=
# REST API admin token (create a read-only API admin for this)
FGT_TOKEN=
# Lab gear usually has self-signed certs; leave false unless you've installed a real cert
FGT_VERIFY_TLS=false

# --- AI Basics Lab ---
# Anthropic API key for the AI lab (stays on the server)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3100
