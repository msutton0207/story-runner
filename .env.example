# Copy this file to .env and fill it in. Never share or commit .env.

# true  = built-in demo data, no lab needed
# false = read from the real FortiGate below
SIM_MODE=true

# FortiGate management IP or hostname (add :port if not 443)
FGT_HOST=
# REST API admin token (create a read-only API admin for this)
FGT_TOKEN=
# Lab gear usually has self-signed certs; leave false unless you've installed a real cert
FGT_VERIFY_TLS=false

# --- Fabric Studio (SD-WAN demo: breaks/repairs lab cables) ---
# Pod address, e.g. 10.50.50.107
FS_HOST=
# OAuth2 credential. On the Fabric Studio CLI run:
#   system oauth2 application default create story-runner
# and paste the single value it prints here.
FS_CREDENTIAL=
FS_VERIFY_TLS=false
# Fabric Studio API path that installs a fabric ({id} = fabric id). Uninstalls any running fabric first.
FS_FABRIC_INSTALL_PATH=/api/v1/runtime/fabric/{id}

# --- Corp_User (SD-WAN demo: live ping and path from the user's side) ---
# Defaults to FS_HOST; port is Corp_User's public SSH forward on the pod
CORP_SSH_HOST=
CORP_SSH_PORT=11002
CORP_SSH_USER=tc
CORP_SSH_PASSWORD=
CORP_PING_TARGET=1.1.1.1
# Guest_User (Who Gets the Backup). It's cloned from Corp_User, so anything left blank here
# uses the CORP_ value above; only the port differs.
GUEST_SSH_PORT=11003
GUEST_SSH_PASSWORD=

# --- AI Basics Lab ---
# Anthropic API key for the AI lab (stays on the server)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3100
